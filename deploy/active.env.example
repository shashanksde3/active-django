# Server settings, installed by provision.sh at /etc/active/active.env (root:active, 0640).
# After editing on the server, apply with: systemctl reload gunicorn-active
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=generated-by-provision-sh
DJANGO_ALLOWED_HOSTS=203.0.113.10,example.com,www.example.com
DJANGO_HTTPS=False
CONTACT_EMAIL=
# Optional:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DEFAULT_FROM_EMAIL=Active Website <noreply@example.com>
# GUNICORN_WORKERS=3
