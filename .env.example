# Copy to .env for local overrides. Server settings live in /etc/active/active.env (see deploy/active.env.example).
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
CONTACT_EMAIL=contact@example.com
DEFAULT_FROM_EMAIL=Active Website <noreply@example.com>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
